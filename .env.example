# Environment — copy to .env and fill in your values

# Server
PORT=4000
NODE_ENV=development

# Database (MongoDB). The database name must be part of the connection string.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/twitter_clone?retryWrites=true&w=majority"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,https://xtwiterfe.vercel.app

# Frontend URL used when a browser opens a POST-only auth endpoint
FRONTEND_URL=https://xtwiterfe.vercel.app

# Cloudinary (image uploads). Leave blank to disable uploads; the rest of the
# app keeps working and image URL fields can still be used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=twitter-clone
